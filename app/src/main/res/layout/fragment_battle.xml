<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_boss"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/anim_boss_idle"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tv_boss_hp_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:text="Boss HP: 0 / 0" />

        <ProgressBar
            android:id="@+id/pb_boss_hp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:progressDrawable="@drawable/pixel_hp_progress"
            android:max="100"
            android:progress="100" />

        <TextView
            android:id="@+id/tv_player_pp_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:text="Your PP: 0" />

        <ProgressBar
            android:id="@+id/pb_player_pp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:progressDrawable="@drawable/pixel_pp_progress"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/tv_attack_chance"
            android:text="Attack chance: "
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_attacks_left"
            android:text="Attacks left: 5"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_attack"
            android:text="Attack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_result"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/victory_animation"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tv_result_text"
        android:text=""
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="#80000000"
        android:padding="12dp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/overlay_rng"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#99000000">

        <TextView
            android:id="@+id/tv_rng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/iv_hitmiss"
            android:layout_width="220dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:scaleType="fitCenter" />

    </FrameLayout>

</FrameLayout>
